# Bu dosyayı .env.local olarak kopyalayın (isteğe bağlı; varsayılan zaten bu değer).
NEXT_PUBLIC_API_URL=http://localhost:5080
# Destek iletişimi (Yardım menüsü, kredi penceresi). Boşsa src/content/support.ts'teki varsayılanlar geçerli.
# WhatsApp numarası uluslararası biçimde, + olmadan.
NEXT_PUBLIC_SUPPORT_WHATSAPP=905359779382
NEXT_PUBLIC_SUPPORT_EMAIL=destek@kobifabrika.com
# Cloudflare Web Analytics (çerezsiz ziyaretçi istatistiği; Cloudflare panelinden alınan site token'ı). Boşsa betik eklenmez.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=
# Sitenin kök adresi (canonical, sitemap, OG görseli). Canlıda https://kobifabrika.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
