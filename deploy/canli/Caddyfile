# Canlı ortam (docs/canli-ortam.md). Sertifikalar Let's Encrypt'ten otomatik (caddy_data biriminde kalır).
# DNS (Cloudflare): kobifabrika.com, www, app, api → bu sunucu, turuncu bulut (Proxied, SSL Full (strict), 2026-10-24).
# 80/443 güvenlik duvarında sadece Cloudflare aralıklarına açık (bin/cloudflare-ip.sh). Sertifika yenilemesi HTTP-01 ile
# Cloudflare üzerinden çalışır (Always Use HTTPS'in 308'i sorun değil: Caddy jetonu 443'te de verir; 2026-10-24 denendi).
# İstek Cloudflare'den geliyorsa gerçek istemci IP'si CF-Connecting-IP'den okunur (sadece aşağıdaki Cloudflare aralıklarından
# gelen isteklerde; doğrudan gelen istekte başlık yok sayılır). API'ye ve web'e X-Forwarded-For olarak tek değer gider.
# Aralıklar: https://www.cloudflare.com/ips-v4 ve /ips-v6 (2026-10-23).
# kobifabrika.com.tr ve www.kobifabrika.com.tr → https://kobifabrika.com (301, yol ve sorgu korunur) Cloudflare'de; bu sunucuya gelmez.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Erişim kaydı (docker logs caddy; local sürücü 10 MB x 5 ile döner). client_ip = Cloudflare arkasında gerçek istemci IP'si.
(kayit) {
	log {
		output stderr
		format json
	}
}

(guvenlik) {
	import kayit
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-X-Powered-By
	}
}

(robotlara-kapali) {
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
"
	}
}

(web) {
	reverse_proxy web:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}

# Tanıtım sitesi ve herkese açık sayfalar (/r/[slug] online randevu, /a anket, /c çıkış, /ekstre, /odeme, /teklif).
kobifabrika.com {
	import guvenlik
	encode zstd gzip
	@uygulama path /panel /panel/* /platform /platform/*
	redir @uygulama https://app.kobifabrika.com{uri} 302
	import web
}

www.kobifabrika.com, http://www.kobifabrika.com {
	import kayit
	redir https://kobifabrika.com{uri} permanent
}

# İşletme paneli (aynı Next.js; kök /panel'e gider). Arama motorlarına kapalı.
app.kobifabrika.com {
	import guvenlik
	import robotlara-kapali
	encode zstd gzip
	redir / /panel 302
	import web
}

api.kobifabrika.com {
	import guvenlik
	import robotlara-kapali
	encode zstd gzip
	reverse_proxy api:8080 {
		header_up X-Forwarded-For {client_ip}
	}
}
