# Geçici site sunucusu (docs/canli-ortam.md). Sertifikalar Let's Encrypt'ten otomatik (caddy_data biriminde kalır).
# DNS (Cloudflare): kobifabrika.com, www, app, api → bu sunucu, "DNS only" (gri bulut).

(guvenlik) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-X-Powered-By
	}
}

kobifabrika.com {
	import guvenlik
	encode zstd gzip
	reverse_proxy web:3000
}

www.kobifabrika.com, http://www.kobifabrika.com {
	redir https://kobifabrika.com{uri} permanent
}

# Panel ve API ayrı sunucuya kurulana kadar "Çok yakında" (web'in /cok-yakinda sayfası); arama motorlarına kapalı.
app.kobifabrika.com, api.kobifabrika.com {
	import guvenlik
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
"
	}
	@varliklar path /_next/static/* /marka/* /favicon.ico /icon.png /apple-icon.png
	handle @varliklar {
		reverse_proxy web:3000
	}
	handle {
		rewrite * /cok-yakinda
		reverse_proxy web:3000
	}
}
